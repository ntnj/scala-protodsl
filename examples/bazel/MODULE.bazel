module(name = "scala_protodsl_bazel_example")

bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_scala", version = "7.2.6")
bazel_dep(name = "protobuf", version = "35.1")

scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
scala_config.settings(scala_version = "3.8.4")
use_repo(scala_config, "rules_scala_config")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()
use_repo(scala_deps, "rules_scala_toolchains")

maven = use_extension(
    "@rules_jvm_external//:extensions.bzl",
    "maven",
)
maven.install(
    artifacts = ["com.github.ntnj:scala-protodsl:master-SNAPSHOT"],
    known_contributing_modules = ["protobuf"],
    repositories = [
        "https://jitpack.io",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

register_toolchains(
    "//:scala_proto_deps_toolchain",
    "//:scala_proto_toolchain",
    "@rules_scala//protoc:scala_protoc_toolchain_toolchain",
    "@rules_scala_toolchains//...:all",
)
